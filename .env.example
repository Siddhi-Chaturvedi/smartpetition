# ============================================================================
# SmartPetition environment configuration
# Copy this file to `.env` (project root) and adjust. NEVER commit real .env.
# All values below are the defaults used when the variable is absent.
# ============================================================================

# --- Application ------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
DEBUG=true

# --- Database ----------------------------------------------------------------
# SQLite (zero-setup local mode — default):
DATABASE_URL=sqlite:///./smartpetition.db
# PostgreSQL (production-ready mode; used by docker-compose automatically):
# DATABASE_URL=postgresql+psycopg2://smartpetition:smartpetition@localhost:5432/smartpetition
POSTGRES_USER=smartpetition
POSTGRES_PASSWORD=smartpetition
POSTGRES_DB=smartpetition

# --- Auth / security -----------------------------------------------------------
# REQUIRED IN PRODUCTION: long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- First administrator (used ONLY on first database seed) ----------------------
# Leave empty to auto-generate a random password (printed once + backend/FIRST_ADMIN.txt)
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Demo data -------------------------------------------------------------------
# Seeds demo citizen/officer accounts + synthetic grievances (development/testing only)
SEED_DEMO_DATA=true

# --- File uploads ---------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,doc,docx,txt

# --- AI ---------------------------------------------------------------------------------
AI_CONFIDENCE_THRESHOLD=0.55        # below this the case goes to human triage
USE_SENTENCE_TRANSFORMERS=false     # optional heavy dependency for semantic dedup
# LLM summaries (OPTIONAL — everything works without a key; never required for core AI)
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# --- SLA / scheduler ----------------------------------------------------------------------
SLA_CHECK_INTERVAL_SECONDS=60       # background escalation sweep interval
DEFAULT_RESOLUTION_HOURS=72
TIMEZONE=UTC                        # deadlines are UTC calendar hours (documented)

# --- Email (OPTIONAL — in-app notifications always work without this) ----------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@smartpetition.local

# --- Rate limiting --------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SUBMIT_PER_MINUTE=20
